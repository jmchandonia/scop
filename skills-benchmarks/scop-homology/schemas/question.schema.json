{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scop.berkeley.edu/schemas/benchmark-question.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "track", "category", "prompt", "entities", "seed_identifiers", "api_evidence", "expected_answer", "scoring_focus"],
  "properties": {
    "id": {"type": "string", "pattern": "^Q[0-9]{3}_[a-z0-9_]+$"},
    "track": {"enum": ["conformance", "held_out"]},
    "category": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "entities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Canonical biological entity names used only to detect leakage into the public skill."
    },
    "seed_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "api_evidence": {
      "type": "array",
      "items": {"type": "string", "pattern": "^/api/v1/releases/"}
    },
    "expected_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_include", "must_avoid"],
      "properties": {
        "must_include": {"type": "array", "items": {"type": "string"}},
        "must_avoid": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scoring_focus": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
