{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answers"],
  "properties": {
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "answer", "evidence_used"],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^Q[0-9]{3}_[a-z0-9_]+$"
          },
          "answer": {"type": "string", "minLength": 1},
          "evidence_used": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
