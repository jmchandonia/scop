{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scop.berkeley.edu/schemas/benchmark-run-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "releaseObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_release",
        "stable_label",
        "latest_periodic_update",
        "response_sha256"
      ],
      "properties": {
        "stable_release": {
          "type": "string",
          "minLength": 1
        },
        "stable_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_periodic_update": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "run_id",
    "benchmark_id",
    "suite_version",
    "questions_sha256",
    "blind_questions_sha256",
    "condition",
    "model",
    "harness",
    "skill",
    "fixture_manifest_sha256",
    "isolation_audit",
    "evaluation",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "const": "scop-homology"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "questions_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blind_questions_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "condition": {
      "enum": [
        "pretrained_only",
        "pretrained_api",
        "pretrained_skill",
        "pretrained_mcp",
        "pretrained_mcp_skill"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "snapshot",
        "parameters"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "instructions_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "instructions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "skill": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "commit",
        "content_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "fixture_manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "api_access": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "mode",
        "upstream_base_url",
        "openapi_sha256",
        "release_start",
        "release_end",
        "stable_release_consistent",
        "trace_format",
        "trace_tree_sha256",
        "question_trace_count",
        "request_count",
        "successful_response_count",
        "transient_error_count",
        "response_body_count"
      ],
      "properties": {
        "mode": {
          "const": "live_rest_capture"
        },
        "upstream_base_url": {
          "type": "string",
          "format": "uri"
        },
        "openapi_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "release_start": {
          "$ref": "#/$defs/releaseObservation"
        },
        "release_end": {
          "$ref": "#/$defs/releaseObservation"
        },
        "stable_release_consistent": {
          "const": true
        },
        "trace_format": {
          "const": "scop-live-http-v1"
        },
        "trace_tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "question_trace_count": {
          "type": "integer",
          "minimum": 1
        },
        "request_count": {
          "type": "integer",
          "minimum": 1
        },
        "successful_response_count": {
          "type": "integer",
          "minimum": 1
        },
        "transient_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "response_body_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mcp_access": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "server",
        "transport",
        "command",
        "rest_base_url",
        "tool_call_count",
        "tools_used"
      ],
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "stdio",
            "streamable-http"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "rest_base_url": {
          "const": "live_rest_capture_gateway"
        },
        "tool_call_count": {
          "type": "integer",
          "minimum": 1
        },
        "tools_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rejected_reference_count",
        "rejected_references"
      ],
      "properties": {
        "rejected_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "reference"
            ],
            "properties": {
              "question_id": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cost_usd",
        "session_seconds",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens"
      ],
      "properties": {
        "total_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "session_seconds": {
          "type": "number",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "isolation_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "codex_home",
        "question_workspace",
        "event_log_format",
        "forbidden_markers_checked",
        "logs_sha256"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "codex_home": {
          "enum": [
            "fresh_auth_only_per_question",
            "not_applicable"
          ]
        },
        "question_workspace": {
          "const": "one_question_per_session"
        },
        "event_log_format": {
          "enum": [
            "codex_exec_jsonl",
            "claude_stream_json"
          ]
        },
        "forbidden_markers_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logs_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "snapshot",
        "parameters",
        "instructions_sha256",
        "completed_at"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "instructions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "condition": {
            "const": "pretrained_api"
          }
        }
      },
      "then": {
        "properties": {
          "skill": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "enum": [
              "pretrained_skill",
              "pretrained_mcp_skill"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "skill": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "pretrained_mcp"
          }
        }
      },
      "then": {
        "properties": {
          "skill": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "enum": [
              "pretrained_mcp",
              "pretrained_mcp_skill"
            ]
          }
        }
      },
      "then": {
        "required": [
          "api_access",
          "mcp_access"
        ],
        "properties": {
          "fixture_manifest_sha256": {
            "type": "null"
          },
          "api_access": {
            "type": "object"
          },
          "mcp_access": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "enum": [
              "pretrained_only",
              "pretrained_api",
              "pretrained_skill"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "mcp_access": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_version": {
            "const": "4.2.0"
          },
          "condition": {
            "enum": [
              "pretrained_api",
              "pretrained_skill"
            ]
          }
        },
        "required": [
          "suite_version",
          "condition"
        ]
      },
      "then": {
        "required": [
          "api_access"
        ],
        "properties": {
          "fixture_manifest_sha256": {
            "type": "null"
          },
          "api_access": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_version": {
            "const": "4.2.0"
          },
          "condition": {
            "const": "pretrained_only"
          }
        },
        "required": [
          "suite_version",
          "condition"
        ]
      },
      "then": {
        "required": [
          "api_access"
        ],
        "properties": {
          "api_access": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "pretrained_only"
          }
        }
      },
      "then": {
        "properties": {
          "skill": {
            "type": "null"
          },
          "fixture_manifest_sha256": {
            "type": "null"
          },
          "api_access": {
            "type": [
              "null"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_version": {
            "const": "4.0.0"
          },
          "condition": {
            "enum": [
              "pretrained_api",
              "pretrained_skill"
            ]
          }
        },
        "required": [
          "suite_version",
          "condition"
        ]
      },
      "then": {
        "properties": {
          "fixture_manifest_sha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_version": {
            "const": "4.1.0"
          },
          "condition": {
            "enum": [
              "pretrained_api",
              "pretrained_skill"
            ]
          }
        },
        "required": [
          "suite_version",
          "condition"
        ]
      },
      "then": {
        "required": [
          "api_access"
        ],
        "properties": {
          "fixture_manifest_sha256": {
            "type": "null"
          },
          "api_access": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_version": {
            "const": "4.1.0"
          },
          "condition": {
            "const": "pretrained_only"
          }
        },
        "required": [
          "suite_version",
          "condition"
        ]
      },
      "then": {
        "required": [
          "api_access"
        ],
        "properties": {
          "api_access": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_version": {
            "const": "4.3.0"
          },
          "condition": {
            "enum": [
              "pretrained_api",
              "pretrained_skill"
            ]
          }
        },
        "required": [
          "suite_version",
          "condition"
        ]
      },
      "then": {
        "required": [
          "api_access"
        ],
        "properties": {
          "fixture_manifest_sha256": {
            "type": "null"
          },
          "api_access": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite_version": {
            "const": "4.3.0"
          },
          "condition": {
            "const": "pretrained_only"
          }
        },
        "required": [
          "suite_version",
          "condition"
        ]
      },
      "then": {
        "required": [
          "api_access"
        ],
        "properties": {
          "api_access": {
            "type": "null"
          }
        }
      }
    }
  ]
}
