{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluations"],
  "properties": {
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer_id",
          "question_id",
          "biological_reasoning_score",
          "factual_support_score",
          "error_tags",
          "rubric_notes"
        ],
        "properties": {
          "answer_id": {
            "type": "string",
            "pattern": "^A[a-f0-9]{12}$"
          },
          "question_id": {
            "type": "string",
            "pattern": "^Q[0-9]{3}_[a-z0-9_]+$"
          },
          "biological_reasoning_score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 4
          },
          "factual_support_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "error_tags": {
            "type": "array",
            "items": {
              "enum": [
                "api_evidence_error",
                "fabricated_annotation",
                "fabricated_release_fact",
                "fragment_similarity_omission",
                "historical_release_omission",
                "identifier_or_boundary_error",
                "incomplete_answer",
                "missing_annotation_caveat",
                "missing_named_unsafe_transfer",
                "missing_quality_context",
                "missing_required_external_evidence",
                "periodic_release_omission",
                "quality_ranking_error",
                "unsafe_function_transfer",
                "unsupported_homology_claim",
                "unsupported_nonhomology_claim",
                "wrong_classification"
              ]
            }
          },
          "rubric_notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
